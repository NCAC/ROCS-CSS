{
  "name": "rocs-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ROCS specifications, validation tools and Sass workspaces",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "node --test tests/*.test.js",
    "pack:check": "pnpm -r --filter \"./packages/*\" pack --dry-run",
    "lint:css": "stylelint '**/*.{css,scss}'",
    "lint:css:fix": "stylelint '**/*.{css,scss}' --fix",
    "lint:jsx": "eslint --no-error-on-unmatched-pattern '**/*.{jsx,tsx}'",
    "lint": "pnpm run lint:css && pnpm run lint:jsx",
    "validate": "node tools/rocs-validate.js --dir ./examples",
    "validate:strict": "node tools/rocs-validate.js --dir ./examples --strict",
    "validate:json": "node tools/rocs-validate.js --dir ./examples --format json",
    "compile:examples": "sass examples/ProductCard/styles.scss examples/ProductCard/styles.css && sass examples/NavigationMain/styles.scss examples/NavigationMain/styles.css && sass examples/CheckoutForm/styles.scss examples/CheckoutForm/styles.css",
    "check": "pnpm run build && pnpm test && pnpm run lint && pnpm run validate",
    "prepare": "husky install",
    "serve:demo": "node tools/serve-demo.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "rocs",
    "css",
    "scss",
    "methodology",
    "naming-convention",
    "semantic",
    "architecture",
    "frontend",
    "bem",
    "oocss",
    "atomic-css",
    "stylelint"
  ],
  "author": "ncac",
  "license": "MIT",
  "devDependencies": {
    "@release-it/bumper": "^7.0.5",
    "@release-it/conventional-changelog": "^10.0.6",
    "@rocss/rocs": "workspace:*",
    "@rocss/sass": "workspace:*",
    "@rocss/sass-architecture": "workspace:*",
    "eslint": "^9.0.0",
    "express": "^5.3.0",
    "husky": "^8.0.3",
    "release-it": "^19.2.4",
    "sass": "^1.71.0",
    "stylelint": "^16.2.0",
    "stylelint-config-standard-scss": "^13.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NCAC/ROCS-CSS.git"
  },
  "bugs": {
    "url": "https://github.com/NCAC/ROCS-CSS/issues"
  },
  "homepage": "https://github.com/NCAC/ROCS-CSS#readme"
}
