{
  "name": "@rocss/sass",
  "version": "1.1.1",
  "description": "Canonical Sass combinators for ROCS: context, state, scope and part",
  "keywords": [
    "rocs",
    "sass",
    "scss",
    "sass-mixins",
    "css-architecture",
    "combinators"
  ],
  "license": "MIT",
  "author": "ncac",
  "sass": "./_index.scss",
  "style": "./_index.scss",
  "exports": {
    ".": {
      "sass": "./_index.scss",
      "default": "./_index.scss"
    },
    "./context": {
      "sass": "./context/_index.scss",
      "default": "./context/_index.scss"
    },
    "./state": {
      "sass": "./state/_index.scss",
      "default": "./state/_index.scss"
    },
    "./scope": {
      "sass": "./scope/_index.scss",
      "default": "./scope/_index.scss"
    },
    "./part": {
      "sass": "./part/_index.scss",
      "default": "./part/_index.scss"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "_index.scss",
    "context/",
    "state/",
    "scope/",
    "part/",
    "internal/",
    "LICENSE",
    "README.md",
    "README.fr.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NCAC/ROCS-CSS.git",
    "directory": "packages/sass"
  },
  "homepage": "https://github.com/NCAC/ROCS-CSS/tree/main/packages/sass#readme",
  "bugs": {
    "url": "https://github.com/NCAC/ROCS-CSS/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
