{
  "name": "@rocss/sass-architecture",
  "version": "1.1.1",
  "description": "Reference Sass architecture for ROCS with a heuristic static checker",
  "keywords": [
    "rocs",
    "sass",
    "scss",
    "css-architecture",
    "specification",
    "static-analysis",
    "linter"
  ],
  "type": "module",
  "license": "MIT",
  "author": "ncac",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "sass-architecture": "./bin/sass-architecture.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "LICENSE",
    "README.md",
    "README.fr.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/checker.js",
    "./emission": "./src/emission.js",
    "./specification": "./docs/fr/SPECIFICATION.md",
    "./guide": "./docs/fr/GUIDE.md",
    "./docs/*": "./docs/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../tools/build-package-docs.js sass-architecture",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NCAC/ROCS-CSS.git",
    "directory": "packages/sass-architecture"
  },
  "homepage": "https://github.com/NCAC/ROCS-CSS/tree/main/packages/sass-architecture#readme",
  "bugs": {
    "url": "https://github.com/NCAC/ROCS-CSS/issues"
  },
  "dependencies": {
    "postcss": "^8.5.31",
    "postcss-scss": "^4.0.9",
    "postcss-selector-parser": "^7.1.6"
  },
  "peerDependencies": {
    "sass": ">=1.71.0"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  }
}
