{
  "name": "@rocss/rocs",
  "version": "1.1.2",
  "description": "ROCS specification and heuristic HTML/CSS validation tools",
  "keywords": [
    "rocs",
    "css",
    "scss",
    "methodology",
    "naming-convention",
    "semantic-css",
    "stylelint",
    "stylelint-config",
    "eslint",
    "eslint-plugin",
    "validator"
  ],
  "type": "module",
  "license": "MIT",
  "author": "ncac",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "rocs": "./bin/rocs.js"
  },
  "exports": {
    ".": "./src/validator.js",
    "./eslint": "./eslint.config.js",
    "./eslint-plugin": "./eslint-plugin.js",
    "./stylelint": "./stylelint.config.json",
    "./docs/*": "./docs/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "eslint.config.js",
    "eslint-plugin.js",
    "stylelint.config.json",
    "docs/",
    "LICENSE",
    "README.md",
    "README.fr.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../tools/build-package-docs.js rocs",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "stylelint": "^16.2.0",
    "stylelint-config-standard-scss": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "stylelint-config-standard-scss": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NCAC/ROCS-CSS.git",
    "directory": "packages/rocs"
  },
  "homepage": "https://github.com/NCAC/ROCS-CSS/tree/main/packages/rocs#readme",
  "bugs": {
    "url": "https://github.com/NCAC/ROCS-CSS/issues"
  }
}
